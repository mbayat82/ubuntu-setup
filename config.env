# Generic defaults for any fresh Ubuntu install. Do not put personal values here:
# copy config.local.env.example to config.local.env (git-ignored) and override there.

# Empty = keep the current hostname / timezone.
NEW_HOSTNAME=
TIMEZONE=

# Account that gets SSH hardening, docker group, uv and shell setup.
# Empty = the user who ran sudo.
ADMIN_USER=

# Stages run by default (storage is left out on purpose: it erases a disk).
DEFAULT_STAGES="base ssh updates cleanup firewall tools verify"

# Tools to install, in order (each name is a file in tools/). Add your own here.
# Optional extras: lynis docker tailscale containerlab portainer lazydocker (after docker)
TOOLS="essentials nettools github-cli eza zoxide direnv yq lazygit uv python-tools"

# --- base stage
BASE_PACKAGES="curl ca-certificates gnupg less zstd"

# --- ssh stage: key-only login, no root login (needs a key in authorized_keys)

# --- updates stage: "true" reboots automatically after kernel updates
AUTO_REBOOT=false

# --- cleanup stage (all opt-in)
REMOVE_SNAPD=0
DISABLE_CLOUD_INIT=0
PURGE_PACKAGES=""
DISABLE_UNITS=""

# --- firewall stage
# CIDRs allowed to reach SSH. Empty = SSH from anywhere.
SSH_ALLOW_CIDRS=""
# 1 = also allow SSH on the tailscale0 interface
UFW_TAILSCALE=0
# CIDRs allowed to reach everything on this host (e.g. a lab management subnet)
UFW_TRUSTED_CIDRS=""

# --- storage stage: whole disk to ERASE and mount (check: lsblk -o NAME,SIZE,MODEL,SERIAL)
DATA_DISK=
DATA_MOUNT=/srv/data

# --- tools
ESSENTIAL_PACKAGES="git vim neovim wget btop htop iotop tmux ripgrep fd-find bat fzf jq tree ncdu rsync unzip zip lsof"
# 1 = alias ls/ll/la/lt to eza; 1 = make cd the zoxide smart jump (otherwise use z)
EZA_ALIASES=1
ZOXIDE_REPLACE_CD=1
NET_PACKAGES="net-tools dnsutils mtr-tiny traceroute tcpdump nmap iperf3 whois"
PYTHON_APT_PACKAGES="build-essential python3-dev python3-venv"
# uv installs this Python (empty = latest); UV_TOOLS are installed with `uv tool install`
UV_PYTHON=
UV_TOOLS="ruff mypy pytest ipython pre-commit httpie jc"
# Empty = latest containerlab
CLAB_VERSION=
