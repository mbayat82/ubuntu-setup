# Copy to config.local.env (git-ignored) and edit. Values here override config.env.
# This example is a home-lab server running containerlab.

NEW_HOSTNAME=myserver
TIMEZONE=UTC
ADMIN_USER=admin

SSH_ALLOW_CIDRS="192.168.1.0/24"
UFW_TAILSCALE=1
UFW_TRUSTED_CIDRS="172.16.0.0/24"

REMOVE_SNAPD=1
DISABLE_CLOUD_INIT=1
PURGE_PACKAGES="multipath-tools modemmanager lxd-installer landscape-common"
DISABLE_UNITS="multipathd.service multipathd.socket ModemManager.service"

TOOLS="essentials nettools github-cli eza zoxide direnv yq lazygit uv python-tools lynis tailscale docker lazydocker containerlab portainer"
# CLAB_VERSION=0.77.0
